{
  "name": "fhirpath-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-native FHIRPath engine with compile-time type inference and a spec §11 static analyzer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/fhirpath-ts.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./r4": "./src/r4/index.ts",
    "./analyzer": "./src/analyzer/analyze.ts",
    "./eslint": "./src/eslint/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate:r4": "node scripts/generate-r4-model.ts",
    "check:fhirpath": "node src/cli/fhirpath-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@medplum/definitions": "^5.1.6",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.2",
    "fast-xml-parser": "^5.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "bin": {
    "fhirpath-check": "./src/cli/fhirpath-check.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
