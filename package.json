{
  "name": "fhirpath-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-native FHIRPath engine with compile-time type inference and a spec §11 static analyzer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/fhirpath-ts.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./r4": "./src/r4/index.ts",
    "./analyzer": "./src/analyzer/analyze.ts",
    "./eslint": "./src/eslint/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "generate:r4": "node scripts/generate-r4-model.ts",
    "check:fhirpath": "node src/cli/fhirpath-check.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@medplum/definitions": "^5.1.6",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-xml-parser": "^5.3.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc}": [
      "prettier --write"
    ]
  },
  "bin": {
    "fhirpath-check": "./src/cli/fhirpath-check.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
