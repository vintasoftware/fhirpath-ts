{
  "name": "fhirpath-ts",
  "version": "0.1.0",
  "description": "TypeScript-native FHIRPath engine with compile-time type inference and a spec §11 static analyzer.",
  "keywords": [
    "fhirpath",
    "fhir",
    "hl7",
    "healthcare",
    "interoperability",
    "r4",
    "static-analysis",
    "type-inference",
    "eslint-plugin",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Vinta Software (https://github.com/vintasoftware)",
  "homepage": "https://github.com/vintasoftware/fhirpath-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/fhirpath-ts.git"
  },
  "bugs": {
    "url": "https://github.com/vintasoftware/fhirpath-ts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/functions/*.js",
    "./src/functions/*.ts",
    "./dist/cli/*.js",
    "./src/cli/*.ts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./r4": "./src/r4/index.ts",
    "./analyzer": "./src/analyzer/index.ts",
    "./eslint": "./src/eslint/index.ts",
    "./sites": "./src/sites/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "fhirpath-check": "./src/cli/fhirpath-check.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./r4": {
        "types": "./dist/r4/index.d.ts",
        "default": "./dist/r4/index.js"
      },
      "./analyzer": {
        "types": "./dist/analyzer/index.d.ts",
        "default": "./dist/analyzer/index.js"
      },
      "./eslint": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.js"
      },
      "./sites": {
        "types": "./dist/sites/index.d.ts",
        "default": "./dist/sites/index.js"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "fhirpath-check": "./dist/cli/fhirpath-check.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:type-perf": "node scripts/check-type-perf.ts",
    "check:package": "node scripts/check-package.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "generate:r4": "node scripts/generate-r4-model.ts",
    "check:fhirpath": "node src/cli/fhirpath-check.ts",
    "prepack": "pnpm run build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.2",
    "@medplum/definitions": "5.1.24",
    "@medplum/fhirtypes": "5.1.24",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-check": "^4.9.0",
    "fast-xml-parser": "^5.3.2",
    "fhirpath": "^4.11.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.4",
    "npm": "11.11.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.23",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
